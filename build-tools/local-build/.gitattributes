# =============================================================================
#  行尾策略
#    * 仓库内统一存 LF（text=auto）
#    * Linux/macOS 脚本与所有文本文件：checkout 也是 LF
#    * Windows 批处理 / PowerShell：checkout 为 CRLF（cmd.exe 与 PS 5.1 更省心）
# =============================================================================
* text=auto

# --- 必须是 LF ---
*.sh              text eol=lf
*.conf            text eol=lf
*.example         text eol=lf
*.md              text eol=lf
*.txt             text eol=lf
*.in              text eol=lf
*.yml             text eol=lf
*.yaml            text eol=lf
*.json            text eol=lf
*.cmake           text eol=lf
gradlew           text eol=lf
Dockerfile        text eol=lf
*.dockerignore    text eol=lf
.gitattributes    text eol=lf
.gitignore        text eol=lf

# --- 必须是 CRLF ---
*.bat             text eol=crlf
*.cmd             text eol=crlf
*.ps1             text eol=crlf
*.psm1            text eol=crlf

# --- 二进制 ---
*.png             binary
*.jpg             binary
*.jpeg            binary
*.ico             binary
*.zip             binary
*.7z              binary
*.gz              binary
*.apk             binary
*.aab             binary
*.exe             binary
*.dll             binary
